//
//  User.swift
//  Generated by LF-Paper from user.json.
//
//  Decode with:
//      let model = try JSONDecoder().decode(User.self, from: data)
//  Dates are ISO 8601, so first set decoder.dateDecodingStrategy = .iso8601

import Foundation

final class User: Codable, Hashable, Identifiable, Sendable {
    let id: Int
    let firstName: String
    let email: String
    let isActive: Bool
    let score: Double
    let createdAt: Date
    let website: URL
    let nickname: JSONValue?
    let `default`: String
    let address: Address
    let tags: [String]
    let orders: [Order]
    let ratings: [Int?]
    let history: [JSONValue] // empty in the sample, so the item type is unknown
    let metadata: [JSONValue]

    enum CodingKeys: String, CodingKey {
        case id
        case firstName = "first_name"
        case email
        case isActive = "is_active"
        case score
        case createdAt = "created_at"
        case website
        case nickname
        case `default`
        case address
        case tags
        case orders
        case ratings
        case history
        case metadata
    }

    init(
        id: Int,
        firstName: String,
        email: String,
        isActive: Bool,
        score: Double,
        createdAt: Date,
        website: URL,
        nickname: JSONValue? = nil,
        `default`: String,
        address: Address,
        tags: [String],
        orders: [Order],
        ratings: [Int?],
        history: [JSONValue],
        metadata: [JSONValue]
    ) {
        self.id = id
        self.firstName = firstName
        self.email = email
        self.isActive = isActive
        self.score = score
        self.createdAt = createdAt
        self.website = website
        self.nickname = nickname
        self.`default` = `default`
        self.address = address
        self.tags = tags
        self.orders = orders
        self.ratings = ratings
        self.history = history
        self.metadata = metadata
    }

    static func == (lhs: User, rhs: User) -> Bool {
        lhs.id == rhs.id
            && lhs.firstName == rhs.firstName
            && lhs.email == rhs.email
            && lhs.isActive == rhs.isActive
            && lhs.score == rhs.score
            && lhs.createdAt == rhs.createdAt
            && lhs.website == rhs.website
            && lhs.nickname == rhs.nickname
            && lhs.`default` == rhs.`default`
            && lhs.address == rhs.address
            && lhs.tags == rhs.tags
            && lhs.orders == rhs.orders
            && lhs.ratings == rhs.ratings
            && lhs.history == rhs.history
            && lhs.metadata == rhs.metadata
    }

    func hash(into hasher: inout Hasher) {
        hasher.combine(id)
        hasher.combine(firstName)
        hasher.combine(email)
        hasher.combine(isActive)
        hasher.combine(score)
        hasher.combine(createdAt)
        hasher.combine(website)
        hasher.combine(nickname)
        hasher.combine(`default`)
        hasher.combine(address)
        hasher.combine(tags)
        hasher.combine(orders)
        hasher.combine(ratings)
        hasher.combine(history)
        hasher.combine(metadata)
    }
}

final class Address: Codable, Hashable, Sendable {
    let street: String
    let city: String
    let geo: Geo

    init(street: String, city: String, geo: Geo) {
        self.street = street
        self.city = city
        self.geo = geo
    }

    static func == (lhs: Address, rhs: Address) -> Bool {
        lhs.street == rhs.street
            && lhs.city == rhs.city
            && lhs.geo == rhs.geo
    }

    func hash(into hasher: inout Hasher) {
        hasher.combine(street)
        hasher.combine(city)
        hasher.combine(geo)
    }
}

final class Geo: Codable, Hashable, Sendable {
    let lat: Double
    let lng: Double

    init(lat: Double, lng: Double) {
        self.lat = lat
        self.lng = lng
    }

    static func == (lhs: Geo, rhs: Geo) -> Bool {
        lhs.lat == rhs.lat
            && lhs.lng == rhs.lng
    }

    func hash(into hasher: inout Hasher) {
        hasher.combine(lat)
        hasher.combine(lng)
    }
}

final class Order: Codable, Hashable, Sendable {
    let orderId: Int
    let total: Double
    let items: [Item]
    let coupon: String?

    enum CodingKeys: String, CodingKey {
        case orderId = "order_id"
        case total
        case items
        case coupon
    }

    init(
        orderId: Int,
        total: Double,
        items: [Item],
        coupon: String? = nil
    ) {
        self.orderId = orderId
        self.total = total
        self.items = items
        self.coupon = coupon
    }

    static func == (lhs: Order, rhs: Order) -> Bool {
        lhs.orderId == rhs.orderId
            && lhs.total == rhs.total
            && lhs.items == rhs.items
            && lhs.coupon == rhs.coupon
    }

    func hash(into hasher: inout Hasher) {
        hasher.combine(orderId)
        hasher.combine(total)
        hasher.combine(items)
        hasher.combine(coupon)
    }
}

final class Item: Codable, Hashable, Sendable {
    let sku: String
    let qty: Int

    init(sku: String, qty: Int) {
        self.sku = sku
        self.qty = qty
    }

    static func == (lhs: Item, rhs: Item) -> Bool {
        lhs.sku == rhs.sku
            && lhs.qty == rhs.qty
    }

    func hash(into hasher: inout Hasher) {
        hasher.combine(sku)
        hasher.combine(qty)
    }
}

/// A value whose type differs across the sample, or couldn't be told from it.
enum JSONValue: Codable, Hashable, Sendable {
    case string(String)
    case number(Double)
    case bool(Bool)
    case object([String: JSONValue])
    case array([JSONValue])
    case null

    init(from decoder: any Decoder) throws {
        let container = try decoder.singleValueContainer()
        if container.decodeNil() {
            self = .null
        } else if let value = try? container.decode(Bool.self) {
            self = .bool(value)
        } else if let value = try? container.decode(Double.self) {
            self = .number(value)
        } else if let value = try? container.decode(String.self) {
            self = .string(value)
        } else if let value = try? container.decode([JSONValue].self) {
            self = .array(value)
        } else {
            self = .object(try container.decode([String: JSONValue].self))
        }
    }

    func encode(to encoder: any Encoder) throws {
        var container = encoder.singleValueContainer()
        switch self {
        case .string(let value): try container.encode(value)
        case .number(let value): try container.encode(value)
        case .bool(let value): try container.encode(value)
        case .object(let value): try container.encode(value)
        case .array(let value): try container.encode(value)
        case .null: try container.encodeNil()
        }
    }
}
