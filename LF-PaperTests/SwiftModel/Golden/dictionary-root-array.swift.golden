import Foundation

struct User {
    let id: Int
    let name: String
    let email: Any?

    init?(dictionary: [String: Any]) {
        if let value = dictionary["id"] as? Int { self.id = value } else { return nil }
        if let value = dictionary["name"] as? String { self.name = value } else { return nil }
        self.email = dictionary["email"]
    }

    var dictionary: [String: Any] {
        var json: [String: Any] = [:]
        json["id"] = self.id
        json["name"] = self.name
        json["email"] = self.email
        return json
    }
}
