//
//  User.swift
//  Generated by LF-Paper from user.json.
//
//  Decode with:
//      let model = try JSONDecoder().decode(User.self, from: data)
//  Dates are ISO 8601, so first set decoder.dateDecodingStrategy = .iso8601

import Foundation

struct User: Decodable {
    let id: Int
    let firstName: String
    let email: String
    let isActive: Bool
    let score: Double
    let createdAt: Date
    let website: URL
    let nickname: JSONValue?
    let `default`: String
    let address: Address
    let tags: [String]
    let orders: [Order]
    let ratings: [Int?]
    let history: [JSONValue] // empty in the sample, so the item type is unknown
    let metadata: [JSONValue]

    enum CodingKeys: String, CodingKey {
        case id
        case firstName = "first_name"
        case email
        case isActive = "is_active"
        case score
        case createdAt = "created_at"
        case website
        case nickname
        case `default`
        case address
        case tags
        case orders
        case ratings
        case history
        case metadata
    }
}

struct Address: Decodable {
    let street: String
    let city: String
    let geo: Geo
}

struct Geo: Decodable {
    let lat: Double
    let lng: Double
}

struct Order: Decodable {
    let orderId: Int
    let total: Double
    let items: [Item]
    let coupon: String?

    enum CodingKeys: String, CodingKey {
        case orderId = "order_id"
        case total
        case items
        case coupon
    }
}

struct Item: Decodable {
    let sku: String
    let qty: Int
}

/// A value whose type differs across the sample, or couldn't be told from it.
enum JSONValue: Decodable, Hashable, Sendable {
    case string(String)
    case number(Double)
    case bool(Bool)
    case object([String: JSONValue])
    case array([JSONValue])
    case null

    init(from decoder: any Decoder) throws {
        let container = try decoder.singleValueContainer()
        if container.decodeNil() {
            self = .null
        } else if let value = try? container.decode(Bool.self) {
            self = .bool(value)
        } else if let value = try? container.decode(Double.self) {
            self = .number(value)
        } else if let value = try? container.decode(String.self) {
            self = .string(value)
        } else if let value = try? container.decode([JSONValue].self) {
            self = .array(value)
        } else {
            self = .object(try container.decode([String: JSONValue].self))
        }
    }
}
