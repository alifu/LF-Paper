//
//  User.swift
//  Generated by LF-Paper from user.json.
//
//  Encode with:
//      let data = try JSONEncoder().encode(model)
//  Dates are ISO 8601, so first set encoder.dateEncodingStrategy = .iso8601

import Foundation

struct User: Encodable {
    let id: Int
    let firstName: String
    let email: String
    let isActive: Bool
    let score: Double
    let createdAt: Date
    let website: URL
    let nickname: JSONValue?
    let `default`: String
    let address: Address
    let tags: [String]
    let orders: [Order]
    let ratings: [Int?]
    let history: [JSONValue] // empty in the sample, so the item type is unknown
    let metadata: [JSONValue]

    enum CodingKeys: String, CodingKey {
        case id
        case firstName = "first_name"
        case email
        case isActive = "is_active"
        case score
        case createdAt = "created_at"
        case website
        case nickname
        case `default`
        case address
        case tags
        case orders
        case ratings
        case history
        case metadata
    }
}

struct Address: Encodable {
    let street: String
    let city: String
    let geo: Geo
}

struct Geo: Encodable {
    let lat: Double
    let lng: Double
}

struct Order: Encodable {
    let orderId: Int
    let total: Double
    let items: [Item]
    let coupon: String?

    enum CodingKeys: String, CodingKey {
        case orderId = "order_id"
        case total
        case items
        case coupon
    }
}

struct Item: Encodable {
    let sku: String
    let qty: Int
}

/// A value whose type differs across the sample, or couldn't be told from it.
enum JSONValue: Encodable, Hashable, Sendable {
    case string(String)
    case number(Double)
    case bool(Bool)
    case object([String: JSONValue])
    case array([JSONValue])
    case null

    func encode(to encoder: any Encoder) throws {
        var container = encoder.singleValueContainer()
        switch self {
        case .string(let value): try container.encode(value)
        case .number(let value): try container.encode(value)
        case .bool(let value): try container.encode(value)
        case .object(let value): try container.encode(value)
        case .array(let value): try container.encode(value)
        case .null: try container.encodeNil()
        }
    }
}
